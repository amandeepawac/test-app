generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum UserRole {
  JOB_SEEKER
  EMPLOYER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DISABLED
  DELETED
}

enum AuthProvider {
  EMAIL_PASSWORD
  GOOGLE
}

enum OtpPurpose {
  SIGN_IN
  PHONE_VERIFICATION
  ACCOUNT_RECOVERY
}

enum LocationType {
  COUNTRY
  STATE
  DISTRICT
  CITY
  LOCALITY
}

enum EmployerType {
  COMPANY
  SMALL_BUSINESS
  SHOP
  FACTORY
  RESTAURANT
  CONTRACTOR
  NON_PROFIT
  HOUSEHOLD
  INDIVIDUAL
  OTHER
}

enum EmployerVerificationStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  NEEDS_MORE_INFO
  SUSPENDED
}

enum EmployerVerificationLevel {
  NONE
  BASIC
  BUSINESS
  TRUSTED
}

enum EmployerDocumentType {
  GST_CERTIFICATE
  UDYAM_CERTIFICATE
  SHOP_ESTABLISHMENT_REGISTRATION
  TRADE_LICENSE
  INCORPORATION_CERTIFICATE
  BUSINESS_ADDRESS_PROOF
  BUSINESS_BANK_PROOF
  FSSAI_LICENSE
  REPRESENTATIVE_AUTHORIZATION
  OTHER
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  DAILY_WAGE
  APPRENTICESHIP
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum SalaryPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
  FIXED
  NEGOTIABLE
}

enum ExperienceLevel {
  NO_EXPERIENCE
  ENTRY_LEVEL
  LESS_THAN_1_YEAR
  ONE_TO_THREE_YEARS
  THREE_TO_FIVE_YEARS
  FIVE_TO_TEN_YEARS
  TEN_PLUS_YEARS
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  REJECTED
  CLOSED
  FILLED
  EXPIRED
  REMOVED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  CONTACTED
  REJECTED
  HIRED
  WITHDRAWN
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  NEW_APPLICATION_RECEIVED
  EMPLOYER_VERIFICATION_SUBMITTED
  EMPLOYER_VERIFICATION_APPROVED
  EMPLOYER_VERIFICATION_REJECTED
  EMPLOYER_VERIFICATION_NEEDS_INFO
  JOB_APPROVED
  JOB_REJECTED
  JOB_PAUSED
  JOB_REMOVED
  ACCOUNT_NOTICE
  SAFETY_NOTICE
  SYSTEM
}

enum ReportReason {
  FAKE_JOB
  FRAUD_OR_SCAM
  REQUESTS_MONEY
  MISLEADING_INFORMATION
  DISCRIMINATION
  HARASSMENT_OR_ABUSE
  IMPERSONATION
  UNSAFE_WORK
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTION_TAKEN
  DISMISSED
  CLOSED
}

// Models

model AuthRateLimit {
  key       String   @id
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model User {
  id                String        @id @default(uuid(7)) @db.Uuid
  email             String        @unique
  emailVerifiedAt   DateTime?
  name              String?
  avatarUrl         String?
  primaryRole       UserRole      @default(JOB_SEEKER)
  status            AccountStatus @default(ACTIVE)
  preferredLanguage String        @default("pa") @db.VarChar(10)
  phone             String?       @unique @db.VarChar(20)
  lastLoginAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  passwordCredential        PasswordCredential?
  authProviders             UserAuthProvider[]
  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  sessions                  AuthSession[]
  seekerProfile             SeekerProfile?
  employerProfile           EmployerProfile?
  notifications             Notification[]
  reportsFiled              Report[]                   @relation("ReportReporter")
  reportsAgainstUser        Report[]                   @relation("ReportTargetUser")
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  employerVerificationsDone EmployerProfile[]          @relation("EmployerVerifiedBy")
  employerDocumentsReviewed EmployerDocument[]         @relation("EmployerDocumentReviewer")
  applicationStatusChanges  ApplicationStatusHistory[] @relation("ApplicationStatusActor")
  reportsReviewed           Report[]                   @relation("ReportReviewer")
  jobsModerated             Job[]                      @relation("JobModerator")

  @@index([primaryRole, status])
  @@index([createdAt])
  @@map("users")
}

model UserAuthProvider {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  provider       AuthProvider
  providerUserId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("user_auth_providers")
}

// One row represents one logged-in device/browser session.
// Revoke the session to log out that device and invalidate its refresh-token family.
model AuthSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  userAgent  String?
  ipAddress  String?   @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model PasswordCredential {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model EmailVerificationToken {
  id                  String    @id @default(uuid(7)) @db.Uuid
  userId              String    @db.Uuid
  tokenHash           String    @unique
  pendingPasswordHash String?
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Each refresh token is stored as a hash and rotated after successful use.
// Reuse of a consumed token should revoke the entire parent AuthSession.
model AuthRefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessionId  String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  authSession AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("auth_refresh_tokens")
}

// Reserved for a future phone-verification/recovery flow; not used for Google login.
model OtpRequest {
  id         String     @id @default(uuid(7)) @db.Uuid
  phone      String     @db.VarChar(20)
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

model SeekerProfile {
  id                       String           @id @default(uuid(7)) @db.Uuid
  userId                   String           @unique @db.Uuid
  fullName                 String?
  headline                 String?
  bio                      String?
  profilePhotoUrl          String?
  locationId               String?          @db.Uuid
  stateName                String?
  cityName                 String?
  addressText              String?
  latitude                 Decimal?         @db.Decimal(10, 7)
  longitude                Decimal?         @db.Decimal(10, 7)
  experienceLevel          ExperienceLevel?
  experienceSummary        String?
  educationSummary         String?
  expectedSalaryMin        Decimal?         @db.Decimal(12, 2)
  expectedSalaryMax        Decimal?         @db.Decimal(12, 2)
  salaryPeriod             SalaryPeriod?
  preferredEmploymentTypes EmploymentType[] @default([])
  isAvailable              Boolean          @default(true)
  availabilityNote         String?
  showEmail                Boolean          @default(false)
  showPhone                Boolean          @default(false)
  completedAt              DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  location     Location?        @relation("SeekerLocation", fields: [locationId], references: [id], onDelete: SetNull)
  skills       SeekerSkill[]
  applications JobApplication[]
  savedJobs    SavedJob[]

  @@index([locationId])
  @@index([isAvailable, experienceLevel])
  @@map("seeker_profiles")
}

model EmployerProfile {
  id                      String                     @id @default(uuid(7)) @db.Uuid
  userId                  String                     @unique @db.Uuid
  employerType            EmployerType?
  businessName            String?
  contactPersonName       String?
  businessDescription     String?
  businessPhone           String?                    @db.VarChar(20)
  websiteUrl              String?
  locationId              String?                    @db.Uuid
  addressLine             String?
  cityName                String?
  districtName            String?
  stateName               String?
  postalCode              String?                    @db.VarChar(12)
  latitude                Decimal?                   @db.Decimal(10, 7)
  longitude               Decimal?                   @db.Decimal(10, 7)
  verificationStatus      EmployerVerificationStatus @default(NOT_SUBMITTED)
  verificationLevel       EmployerVerificationLevel  @default(NONE)
  verificationSubmittedAt DateTime?
  verifiedAt              DateTime?
  verifiedById            String?                    @db.Uuid
  rejectionReason         String?
  verificationNote        String?
  nextReviewAt            DateTime?
  showEmail               Boolean                    @default(false)
  showPhone               Boolean                    @default(false)
  completedAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location?          @relation("EmployerLocation", fields: [locationId], references: [id], onDelete: SetNull)
  verifiedBy User?              @relation("EmployerVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  documents  EmployerDocument[]
  jobs       Job[]
  reports    Report[]

  @@index([verificationStatus, createdAt])
  @@index([verificationLevel])
  @@index([locationId])
  @@index([businessName])
  @@map("employer_profiles")
}

model EmployerDocument {
  id             String               @id @default(uuid(7)) @db.Uuid
  employerId     String               @db.Uuid
  documentType   EmployerDocumentType
  storageKey     String
  originalName   String?
  mimeType       String?              @db.VarChar(120)
  fileSizeBytes  BigInt?
  documentNumber String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  reviewStatus   DocumentReviewStatus @default(PENDING)
  reviewedById   String?              @db.Uuid
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  employer   EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  reviewedBy User?           @relation("EmployerDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employerId, reviewStatus])
  @@index([documentType])
  @@index([expiresAt])
  @@map("employer_documents")
}

model Location {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String?
  type        LocationType
  parentId    String?      @db.Uuid
  countryCode String?      @db.VarChar(2)
  latitude    Decimal?     @db.Decimal(10, 7)
  longitude   Decimal?     @db.Decimal(10, 7)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  parent           Location?         @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Location[]        @relation("LocationHierarchy")
  seekerProfiles   SeekerProfile[]   @relation("SeekerLocation")
  employerProfiles EmployerProfile[] @relation("EmployerLocation")
  jobs             Job[]

  @@unique([parentId, slug])
  @@index([type, name])
  @@index([parentId])
  @@map("locations")
}

model JobCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @db.Uuid
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   JobCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children JobCategory[] @relation("CategoryHierarchy")
  jobs     Job[]

  @@index([parentId, isActive])
  @@map("job_categories")
}

model Skill {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seekerSkills SeekerSkill[]
  jobSkills    JobSkill[]

  @@index([isActive, name])
  @@map("skills")
}

model SeekerSkill {
  id              String   @id @default(uuid(7)) @db.Uuid
  seekerProfileId String   @db.Uuid
  skillId         String   @db.Uuid
  experienceYears Decimal? @db.Decimal(4, 1)
  proficiencyNote String?
  createdAt       DateTime @default(now())

  seeker SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  skill  Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([seekerProfileId, skillId])
  @@index([skillId])
  @@map("seeker_skills")
}

model JobSkill {
  id         String   @id @default(uuid(7)) @db.Uuid
  jobId      String   @db.Uuid
  skillId    String   @db.Uuid
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model Job {
  id                 String          @id @default(uuid(7)) @db.Uuid
  employerId         String          @db.Uuid
  categoryId         String?         @db.Uuid
  locationId         String?         @db.Uuid
  title              String
  slug               String?
  description        String
  responsibilities   String?
  employmentType     EmploymentType
  workMode           WorkMode        @default(ON_SITE)
  experienceLevel    ExperienceLevel @default(NO_EXPERIENCE)
  salaryMin          Decimal?        @db.Decimal(12, 2)
  salaryMax          Decimal?        @db.Decimal(12, 2)
  salaryPeriod       SalaryPeriod    @default(MONTH)
  salaryCurrency     String          @default("INR") @db.VarChar(3)
  isSalaryNegotiable Boolean         @default(false)
  openings           Int             @default(1)
  addressLine        String?
  localityName       String?
  cityName           String?
  districtName       String?
  stateName          String?
  postalCode         String?         @db.VarChar(12)
  latitude           Decimal?        @db.Decimal(10, 7)
  longitude          Decimal?        @db.Decimal(10, 7)
  workingHours       String?
  shiftDetails       String?
  isUrgent           Boolean         @default(false)
  status             JobStatus       @default(DRAFT)
  moderationNote     String?
  moderatedById      String?         @db.Uuid
  moderatedAt        DateTime?
  publishedAt        DateTime?
  expiresAt          DateTime?
  closedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  employer     EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  category     JobCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  moderatedBy  User?            @relation("JobModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  skills       JobSkill[]
  applications JobApplication[]
  savedBy      SavedJob[]
  reports      Report[]

  @@index([status, publishedAt])
  @@index([employerId, status])
  @@index([categoryId, status])
  @@index([locationId, status])
  @@index([cityName, stateName, status])
  @@index([expiresAt])
  @@index([isUrgent, status, publishedAt])
  @@map("jobs")
}

model JobApplication {
  id              String            @id @default(uuid(7)) @db.Uuid
  jobId           String            @db.Uuid
  seekerProfileId String            @db.Uuid
  status          ApplicationStatus @default(APPLIED)
  coverMessage    String?
  employerNote    String?
  appliedAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  withdrawnAt     DateTime?

  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seeker        SeekerProfile              @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  statusHistory ApplicationStatusHistory[]

  @@unique([jobId, seekerProfileId])
  @@index([seekerProfileId, status, appliedAt])
  @@index([jobId, status, appliedAt])
  @@map("job_applications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid(7)) @db.Uuid
  applicationId String             @db.Uuid
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  changedById   String?            @db.Uuid
  note          String?
  createdAt     DateTime           @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?          @relation("ApplicationStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([changedById])
  @@map("application_status_histories")
}

model SavedJob {
  id              String   @id @default(uuid(7)) @db.Uuid
  seekerProfileId String   @db.Uuid
  jobId           String   @db.Uuid
  createdAt       DateTime @default(now())

  seeker SeekerProfile @relation(fields: [seekerProfileId], references: [id], onDelete: Cascade)
  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([seekerProfileId, jobId])
  @@index([jobId])
  @@index([seekerProfileId, createdAt])
  @@map("saved_jobs")
}

model Notification {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  type         NotificationType
  title        String
  body         String
  resourceType String?
  resourceId   String?          @db.Uuid
  data         Json?
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

model Report {
  id               String       @id @default(uuid(7)) @db.Uuid
  reporterId       String       @db.Uuid
  targetJobId      String?      @db.Uuid
  targetEmployerId String?      @db.Uuid
  targetUserId     String?      @db.Uuid
  reason           ReportReason
  description      String?
  status           ReportStatus @default(OPEN)
  reviewedById     String?      @db.Uuid
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  reporter       User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetJob      Job?             @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  targetEmployer EmployerProfile? @relation(fields: [targetEmployerId], references: [id], onDelete: SetNull)
  targetUser     User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  reviewedBy     User?            @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetJobId])
  @@index([targetEmployerId])
  @@index([targetUserId])
  @@map("reports")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
