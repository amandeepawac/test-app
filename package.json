{
  "name": "rozgar-local-app",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "pnpm --parallel --filter web --filter api run format",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:studio": "turbo run db:studio",
    "db:test": "turbo run db:test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,md,yaml,yml,css}": "prettier --write",
    "apps/api/**/*.ts": "pnpm --dir apps/api exec oxlint --type-aware --fix",
    "apps/web/**/*.{ts,tsx}": "pnpm --dir apps/web exec eslint --fix --config eslint.config.js"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.13",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  }
}
