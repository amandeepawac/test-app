  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "seed:demo-users": "node scripts/seed-demo-users.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "argon2": "^0.45.2",
    "google-auth-library": "^11.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
